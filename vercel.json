{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "node_modules/**,**/.vercel/**,**/__pycache__/**,scripts/**,docs/**,data/**,analysis/**,ProyectoDocumento/**,frontend/**,web/**"
    }
  }
}